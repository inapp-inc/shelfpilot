# ShelfPilot production environment (Docker deploy)
# Copy to .env on the server (deploy.sh does this automatically on first run).

NODE_ENV=production

# Host port published by Docker (container always listens on 4520 internally).
# Point your host nginx at 127.0.0.1:${HOST_PORT}.
HOST_PORT=4520

# Deploy subpath — the app is reachable at http://foundry.inapp.com/shelfpilot.
# MUST match the UI build base (VITE_BASE_PATH=/shelfpilot/ baked into web/dist).
# Use "" only if you rebuilt the UI for root.
BASE_PATH=/shelfpilot

# CORS: UI + API are same-origin under /shelfpilot, so this is belt-and-braces.
# Comma-separated allow-list for any cross-origin API callers.
CORS_ORIGINS=http://foundry.inapp.com

# Optional image tag override (defaults to the VERSION file shipped in the package).
# SHELFPILOT_VERSION=0.1.0

# Optional bootstrap super-admin (used only when the DB has no users yet)
# SUPERADMIN_EMAIL=superadmin@shelfpilot.local
# SUPERADMIN_PASSWORD=changeme
# SUPERADMIN_NAME=Platform Super Admin
# AUTH_SESSION_TTL=86400
# LAYOUT_VERSIONING=1

# Phase 0 perf: skip demo Smart Generate on every container restart (data persists in volume).
# Set to 0 only on first deploy / empty DB, then back to 1.
SKIP_DEMO_BOOTSTRAP=1

# Portfolio analytics cache TTL (ms) — default 60000
# PORTFOLIO_CACHE_TTL_MS=60000

# Catalog list cache TTL (ms) — default 30000
# CATALOG_CACHE_TTL_MS=30000
