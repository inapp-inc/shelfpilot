NODE_ENV=development
PORT=3000
# Local lightweight store (SQLite). Use a file path for durable local data.
SQLITE_PATH=./data/shelfpilot.db
# Session TTL in seconds. 0 or unset = long-lived demo sessions.
AUTH_SESSION_TTL=0
# Layout version snapshots on submit-for-review. 0/false to disable.
LAYOUT_VERSIONING=1
# Cloud/managed profile later (not used for local Docker compose):
# MONGODB_URI=mongodb://localhost:27017/shelfpilot
