# ShelfPilot web — Vite build + nginx (proxies API → api:3000)
# Rebuild after code changes (recommended, from ./codebase):
#   npm run docker:rebuild        (sets a fresh CACHEBUST + force-recreates)
# or manually:
#   docker compose build && docker compose up -d --force-recreate
#
# The CACHEBUST arg (fed a fresh timestamp by the rebuild scripts / compose) is
# referenced right before the source COPY so the source + `npm run build` layers
# are ALWAYS rebuilt, while the slow `npm install` layer stays cached.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY web/package.json ./web/
COPY api/package.json ./api/
RUN npm install -w web
# Changing CACHEBUST invalidates every layer below, so edits always ship.
ARG CACHEBUST=dev
RUN echo "cachebust=$CACHEBUST"
# Copy source last so edits invalidate only the build layer (not npm install).
COPY web/index.html web/vite.config.js web/nginx.conf ./web/
COPY web/public ./web/public
COPY web/src ./web/src
RUN npm run build -w web

FROM nginx:1.27-alpine
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
